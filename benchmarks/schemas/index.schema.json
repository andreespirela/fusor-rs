{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Benchmark history index",
  "type": "object",
  "required": ["schemaVersion", "published", "experiments"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "published": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": ["experiment", "evidence", "sha256"],
          "properties": {
            "experiment": {
              "type": "string"
            },
            "evidence": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      ]
    },
    "experiments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "path"],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      }
    }
  }
}
